{
  "name": "reinvent-match",
  "version": "0.2.0",
  "description": "Reinvent:Match - find the AWS re:Invent sessions that fit you: what you know, what you want to learn, your level and your week. Runs locally with your AWS Builder ID. Unofficial community project.",
  "keywords": [
    "aws",
    "reinvent",
    "re:invent",
    "agenda",
    "sessions",
    "aws-events",
    "builder-id"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "reinvent-match": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:web": "vite build",
    "dev": "tsx src/cli.ts",
    "ui": "vite build && tsx src/cli.ts ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc -p tsconfig.scripts.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "personas": "tsx scripts/personas.ts",
    "build:sea": "npm run build && node scripts/build-sea.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "author": "Jose Juarez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ja-juarez-cruz/reinvent-match.git"
  },
  "homepage": "https://github.com/ja-juarez-cruz/reinvent-match#readme",
  "bugs": {
    "url": "https://github.com/ja-juarez-cruz/reinvent-match/issues"
  }
}
